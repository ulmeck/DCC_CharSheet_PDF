				xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
			<dc:format>application/pdf</dc:format>
			<xmpMM:DocumentID>uuid:e19a8306-c381-4817-882a-de4105b68f8d</xmpMM:DocumentID>
